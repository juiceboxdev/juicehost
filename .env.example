# Juicehost Example Settings
# Check config.rs if unsure on what it takes

# Public settings
PUBLIC_HOST=127.0.0.1
PUBLIC_PORT=6402

# QUIC settings
# QUIC_HOST defaults to PUBLIC_HOST
QUIC_HOST=0.0.0.0
# QUIC_PORT defaults to PUBLIC_PORT + 1
QUIC_PORT=6403
# QUIC_CERT_PATH=./quic-cert.der
# QUIC_MAX_CONNECTIONS=256        # 1..65536
# QUIC_MAX_REQUESTS=256           # 1..65536
# QUIC_HANDSHAKE_SECONDS=10       # 1..120
# QUIC_IDLE_SECONDS=30            # 1..600
# QUIC_REQUEST_TOTAL_SECONDS=600  # 1..86400

# Thread Settings
# WORKER_THREADS=3                # 1..256

# Directory Settings
FILES_DIR=./files
# BACKEND_URL=
# FRONTEND_URL=                # Optional! juicefront URL that GET / redirects to (308). Unset keeps a 404 on /.

# Security Settings
# JUICEHOST_API_KEY=               # Optional! Incase you want juicehost to be paired with your juiceback instance only.
# ALLOWED_ORIGINS=                # Optional! Comma-separated; defaults to BACKEND_URL
# DANGER_LEVEL=high               # <- (none, low, medium, high)
# TRUSTED_PROXY_CIDRS=            # Super important if under a rev proxy.
#                                  Uses commas, like a list you know the drill

# S3 Settings
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=
# S3_ALLOW_HTTP=false
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# Limits Settings
# MIN_FREE_SPACE_GB=5             # 1..(u64) GB free disk space required
# MAX_FILE_SIZE_MB=500            # 1..1048576 (up to 1 TB)
# MAX_RANGE_RESPONSE_MB=16        # 1..1024
# MAX_CONCURRENT_UPLOADS=16       # 1..4096
# MAX_CONCURRENT_DOWNLOADS=64     # 1..4096
# MAX_CONCAT_PARTS=128            # 1..4096
# TCP_BODY_INACTIVITY_SECONDS=30  # 1..3600
# TCP_REQUEST_TOTAL_SECONDS=600   # 1..86400
# TCP_MAX_CONCURRENT_REQUESTS=512 # 1..65536

# Features Settings
# QUICK_LINK=true
# CUSTOM_ID=true
# DEFAULT_TTL_HOURS=24
# ALLOWED_TTL_HOURS=0.5,1,6,12,24,72,168

# Secrets
# TICKET_JWT_SECRET=              # Defaults to JWT_SECRET, then JUICEHOST_API_KEY
# IP_PEPPER=                      # Optional! Empty disables IP banning

# Ban Settings
# BAN_LIST_FILE=./bans.json
# BAN_SYNC_URL=
# BAN_SYNC_INTERVAL=30            # Seconds between ban list file reloads / backend syncs

# Sentry (very much optional)
# SENTRY_DSN=              # fallback
# SENTRY_DSN_JUICEHOST=    # override for this service
# SENTRY_ENVIRONMENT=production
